<form method="POST" action="<%= action %>">
  <div class="form-grid">
    <div class="field full">
      <label for="name">Name</label>
      <input id="name" name="name" type="text" maxlength="60" required placeholder="e.g. Mortgage (Chase)" value="<%= expense.name || "" %>">
    </div>
    <div class="field">
      <label for="category">Category</label>
      <select id="category" name="category" required>
        <% categories.forEach((c) => { %>
          <option <%= c === expense.category ? "selected" : "" %>><%= c %></option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label for="monthly_amount">Monthly amount ($)</label>
      <input id="monthly_amount" name="monthly_amount" type="number" min="0" step="0.01" required value="<%= expense.monthly_amount ?? "" %>">
    </div>
  </div>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary"><%= submitLabel %></button>
    <% if (locals.cancelHref) { %><a class="btn btn-secondary" href="<%= cancelHref %>">Cancel</a><% } %>
  </div>
</form>
