<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title ? title + " · RoomSplit" : "RoomSplit" %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%
  // Logged-in owners see the app; visitors see the public pages
  const links = currentUser
    ? [["/dashboard", "Dashboard"], ["/rooms", "Rooms"], ["/tenants", "Tenants"], ["/payments", "Payments"], ["/expenses", "Costs"], ["/scenarios", "Scenarios"]]
    : [["/", "Home"], ["/about", "About"]];
%>
<header class="site-header">
  <nav class="nav" aria-label="Main">
    <a class="brand" href="/">
      <span class="logo" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
      RoomSplit
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
      <span></span><span></span><span></span>
      <span class="visually-hidden">Menu</span>
    </button>
    <div class="nav-menu" id="nav-menu">
      <ul class="nav-links">
        <% links.forEach(([href, label]) => { %>
          <li><a href="<%= href %>" class="<%= (href === "/" ? currentPath === "/" : currentPath.startsWith(href)) ? "active" : "" %>"><%= label %></a></li>
        <% }) %>
      </ul>
      <div class="nav-user">
        <% if (currentUser) { %>
          <span class="user-chip">
            <span class="avatar" aria-hidden="true"><%= currentUser.name.charAt(0).toUpperCase() %></span>
            <span>Hi, <strong><%= currentUser.name %></strong></span>
          </span>
          <form method="POST" action="/logout">
            <button type="submit" class="btn btn-secondary btn-sm">Log out</button>
          </form>
        <% } else { %>
          <a class="btn btn-ghost btn-sm" href="/login">Log in</a>
          <a class="btn btn-primary btn-sm" href="/register">Sign up</a>
        <% } %>
      </div>
    </div>
  </nav>
</header>
<main class="container">
  <% if (flash) { %>
    <div class="flash flash-<%= flash.type %>" role="status">
      <span><%= flash.message %></span>
      <button type="button" class="flash-close" aria-label="Dismiss">&times;</button>
    </div>
  <% } %>
