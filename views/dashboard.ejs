<%- include("partials/header") %>

<div class="page-head">
  <div>
    <h1>Welcome back, <%= currentUser.name %></h1>
    <p>Here's how your home is doing in <%= monthLabel(month) %>.</p>
  </div>
  <div class="actions">
    <a class="btn btn-secondary" href="/payments">Log a payment</a>
    <a class="btn btn-primary" href="/scenarios">Compare scenarios</a>
  </div>
</div>

<% if (!rooms.length || !stats.costs) { %>
  <div class="card" style="margin-bottom: 1.25rem;">
    <h2>Get set up</h2>
    <p class="muted">Three quick steps and your dashboard fills itself in.</p>
    <ul class="list">
      <li><span><%= stats.costs ? "✓" : "1." %> Add your shared costs (mortgage, HOA, utilities, internet)</span><a class="btn btn-secondary btn-sm" href="/expenses">Costs</a></li>
      <li><span><%= rooms.length ? "✓" : "2." %> Add each room and its rent</span><a class="btn btn-secondary btn-sm" href="/rooms">Rooms</a></li>
      <li><span>3. Add tenants and assign them to rooms</span><a class="btn btn-secondary btn-sm" href="/tenants">Tenants</a></li>
    </ul>
  </div>
<% } %>

<div class="grid grid-4">
  <div class="stat">
    <div class="stat-label">Monthly rent</div>
    <div class="stat-value"><%= money(stats.expectedRent) %></div>
    <div class="stat-sub"><%= money(stats.collected) %> collected so far</div>
  </div>
  <div class="stat">
    <div class="stat-label">Monthly costs</div>
    <div class="stat-value"><%= money(stats.costs) %></div>
    <div class="stat-sub"><a href="/expenses">See the breakdown</a></div>
  </div>
  <div class="stat">
    <div class="stat-label">Net cash flow</div>
    <div class="stat-value <%= stats.net >= 0 ? "positive" : "negative" %>"><%= stats.net < 0 ? "−" : "" %><%= money(Math.abs(stats.net)) %></div>
    <div class="stat-sub"><%= stats.net < 0 ? "−" : "" %><%= money(Math.abs(stats.net * 12)) %> a year at this rate</div>
  </div>
  <div class="stat">
    <div class="stat-label">Occupancy</div>
    <div class="stat-value"><%= stats.occupancy %>%</div>
    <div class="stat-sub"><%= stats.occupied %> of <%= rooms.length %> room<%= rooms.length === 1 ? "" : "s" %> rented</div>
    <div class="meter" role="img" aria-label="<%= stats.occupancy %>% occupied"><span style="width: <%= stats.occupancy %>%"></span></div>
  </div>
</div>

<div class="grid grid-2 section">
  <div class="card">
    <div class="card-head">
      <h2>Overdue rent</h2>
      <span class="badge <%= overdue.length ? "badge-danger" : "badge-success" %>"><%= overdue.length %></span>
    </div>
    <% if (!overdue.length) { %>
      <p class="muted" style="margin: 0;">Nobody is behind on rent this month.</p>
    <% } else { %>
      <ul class="list">
        <% overdue.forEach((r) => { %>
          <li>
            <span><strong><%= r.tenant_name %></strong> <span class="muted small">&middot; <%= r.name %></span></span>
            <span class="negative num"><%= money(r.monthly_rent - r.paid_this_month) %> owed</span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <div class="card">
    <div class="card-head">
      <h2>Upcoming renewals</h2>
      <span class="muted small">Next <%= renewalWindow %> days</span>
    </div>
    <% if (!renewals.length) { %>
      <p class="muted" style="margin: 0;">No leases end in the next <%= renewalWindow %> days.</p>
    <% } else { %>
      <ul class="list">
        <% renewals.forEach((t) => { %>
          <li>
            <span><strong><%= t.name %></strong> <span class="muted small">&middot; <%= t.room_name || "No room" %></span></span>
            <span class="badge badge-warning">Ends <%= formatDate(t.lease_end) %></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</div>

<div class="grid grid-2 section">
  <div class="card">
    <div class="card-head">
      <h2>Rent collected vs costs</h2>
      <div class="legend"><span class="income">Rent collected</span><span class="expense">Costs</span></div>
    </div>
    <div id="income-chart"></div>
  </div>

  <div class="card">
    <div class="card-head">
      <h2>Rooms at a glance</h2>
      <a class="small" href="/rooms">Manage rooms</a>
    </div>
    <% if (!rooms.length) { %>
      <p class="muted" style="margin: 0;">No rooms yet.</p>
    <% } else { %>
      <ul class="list">
        <% rooms.forEach((r) => { %>
          <li>
            <span><strong><%= r.name %></strong> <span class="muted small">&middot; <%= r.tenant_name || "No tenant" %></span></span>
            <span><span class="num"><%= money(r.monthly_rent) %></span> <span class="badge <%= r.status.badge %>"><%= r.status.label %></span></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</div>

<script type="application/json" id="chart-data"><%- JSON.stringify(chart).replace(/</g, "\\u003c") %></script>

<%- include("partials/footer") %>
