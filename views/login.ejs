<%- include("partials/header") %>

<section class="auth">
  <% if (locals.loggedOut) { %>
    <div class="flash flash-info" role="status">
      <span>You've been logged out.</span>
      <button type="button" class="flash-close" aria-label="Dismiss">&times;</button>
    </div>
  <% } %>
  <div class="card">
    <h1>Welcome back</h1>
    <p class="sub">Log in to manage your rooms, tenants and costs.</p>

    <% if (error) { %>
      <div class="flash flash-error" role="alert"><span><%= error %></span></div>
    <% } %>

    <form method="POST" action="/login">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field">
        <label for="username">Username</label>
        <input id="username" name="username" type="text" autocomplete="username" required value="<%= values.username || "" %>" autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-block">Log in</button>
      </div>
    </form>
    <p class="switch">New to RoomSplit? <a href="/register">Create an account</a></p>
  </div>
</section>

<%- include("partials/footer") %>
